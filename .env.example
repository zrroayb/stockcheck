# ==============================================================================
# Stock Control App — Environment Variables
# Copy this file to `.env` and fill in the values.
# ==============================================================================

# --- Database ---------------------------------------------------------------
DATABASE_URL="postgresql://stockcontrol:stockcontrol@localhost:5432/stockcontrol?schema=public"

# --- Redis (BullMQ) ---------------------------------------------------------
REDIS_URL="redis://localhost:6379"

# --- Clerk Auth -------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/products"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/products"

# --- Encryption -------------------------------------------------------------
# Generate with:  openssl rand -hex 32
ENCRYPTION_KEY=""

# --- Marketplace webhook secrets --------------------------------------------
SHOPIFY_WEBHOOK_SECRET=""
TRENDYOL_WEBHOOK_SECRET=""
HEPSIBURADA_WEBHOOK_SECRET=""

# --- Email (Resend) ---------------------------------------------------------
RESEND_API_KEY=""
ALERT_FROM_EMAIL="alerts@yourdomain.com"

# --- App --------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
