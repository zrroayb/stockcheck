{
  "name": "stokkontrol",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "workers": "tsx watch workers/index.ts",
    "workers:prod": "tsx workers/index.ts",
    "dev:all": "concurrently -n next,workers -c blue,magenta \"npm run dev\" \"npm run workers\"",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@clerk/nextjs": "^6.39.3",
    "@clerk/themes": "^2.4.57",
    "@prisma/client": "^5.22.0",
    "bullmq": "^5.34.0",
    "clsx": "^2.1.1",
    "dotenv": "^16.4.7",
    "ioredis": "^5.4.2",
    "lucide-react": "^1.14.0",
    "next": "^14.2.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "redlock": "^5.0.0-beta.2",
    "resend": "^4.0.1",
    "tailwind-merge": "^2.5.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.17.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "postcss": "^8.4.49",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.15",
