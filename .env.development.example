# Local development profile.
# Copy to `.env.development` and run `npm run env:use:development`.

APP_ENV="development"
NEXT_PUBLIC_APP_ENV="development"

DATABASE_URL="postgresql://stockcontrol:stockcontrol@localhost:5432/stockcontrol?schema=public"
REDIS_URL="redis://localhost:6379"

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/products"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/products"

ENCRYPTION_KEY=""

SHOPIFY_WEBHOOK_SECRET="dev"
TRENDYOL_WEBHOOK_SECRET="dev"
HEPSIBURADA_WEBHOOK_SECRET="dev"

RESEND_API_KEY=""
ALERT_FROM_EMAIL="alerts@example.com"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
